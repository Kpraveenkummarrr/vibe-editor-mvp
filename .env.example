# Copy this file to .env.local (already gitignored) to enable real AI edits
# via OpenRouter (https://openrouter.ai — free tier available, no credit card
# required for free models). Without this, the editor automatically falls
# back to a local rule-based engine and still works fully offline.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — defaults to a free model. Browse current free models at
# https://openrouter.ai/models?max_price=0 and swap this if the default has
# been deprecated/renamed.
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Copy this file to .env.local (already gitignored) to enable the "Publish"
# button to deploy real, live sites to Netlify. Without this, Publish shows
# setup instructions instead of pretending to deploy.
#
# Get a personal access token at
# https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_API_TOKEN=
