# --- Live AI (chat-driven editing) ---
# Set EITHER or BOTH of these to enable real AI edits instead of the local
# rule-based fallback. If both are set, Gemini is tried first (its free tier
# doesn't require a credit card and its model lineup is more stable than
# OpenRouter's rotating free-model roster); if Gemini fails or isn't
# configured, OpenRouter is tried next; only if both fail/aren't configured
# does it fall back to the local engine. See api/_lib/aiRouter.js.

# Google Gemini — get a free key (no credit card) at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-flash-lite-latest, Google's stable alias for
# their current lightweight flash model. Dated model ids (e.g.
# gemini-2.5-flash) get retired and start 404ing with "no longer available
# to new users", and the non-lite *-latest alias resolves to a "thinking"
# model with a very tight free-tier daily quota that also tends to burn its
# output budget on invisible reasoning instead of the actual answer — the
# lite alias avoids both. Check https://ai.google.dev/gemini-api/docs/models
# if you want to pin a specific dated model instead.
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter — get a key at https://openrouter.ai/keys (free tier available,
# no credit card required for free models)
OPENROUTER_API_KEY=

# Optional — defaults to a free model. Browse current free models at
# https://openrouter.ai/models?max_price=0 and swap this if the default has
# been deprecated/renamed.
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# --- Publish ---
# Copy this file to .env.local (already gitignored) to enable the "Publish"
# button to deploy real, live sites to Vercel. Without this, Publish shows
# setup instructions instead of pretending to deploy.
#
# Get a personal access token at
# https://vercel.com/account/tokens
VERCEL_API_TOKEN=
